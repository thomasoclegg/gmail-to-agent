{
  "manifest_version": 3,
  "name": "Open in AI Agent for Gmail (Claude Code & Codex)",
  "short_name": "Open in AI Agent",
  "version": "1.0.0",
  "description": "Right-click a Gmail thread to start a Claude Code or Codex session on it. Runs on your computer; sends nothing to any server.",
  "homepage_url": "https://github.com/thomasoclegg/gmail-to-agent",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["contextMenus", "storage"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
