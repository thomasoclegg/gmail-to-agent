{
  "manifest_version": 3,
  "name": "Open in AI Agent for Gmail",
  "short_name": "Open in AI Agent",
  "version": "1.4.0",
  "description": "Right-click a Gmail thread to open it in Claude, ChatGPT, Gemini, Claude Code, Codex or another AI. Runs on your computer.",
  "homepage_url": "https://github.com/thomasoclegg/gmail-to-agent",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Open in AI Agent",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+O", "mac": "MacCtrl+Shift+O" }, "description": "Open the list of your AIs" },
    "send-to-last": { "suggested_key": { "default": "Alt+Shift+L", "mac": "MacCtrl+Shift+L" }, "description": "Send to the AI you used last" }
  },
  "permissions": ["contextMenus", "storage", "offscreen", "clipboardWrite", "scripting", "activeTab"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["targets.js", "toast.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
